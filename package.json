{
  "name": "reliable-checkout-rewards-service",
  "version": "1.0.0",
  "description": "A reliable ecommerce checkout and rewards backend built with Node.js, Express, TypeScript, and PostgreSQL, featuring transactional inventory management, idempotent checkout, concurrency-safe coupon redemption, and automated testing.",
  "main": "index.js",
  "scripts": {
      "dev": "tsx watch src/server.ts",
      "start": "tsx src/server.ts",
      "test": "vitest run",
      "typecheck": "tsc --noEmit",
      "db:setup": "tsx src/db/setup.ts",
      "db:seed": "npm run db:setup && tsx src/db/seed.ts"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/suryavamshikachalapalli/reliable-checkout-rewards-service.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/suryavamshikachalapalli/reliable-checkout-rewards-service/issues"
  },
  "homepage": "https://github.com/suryavamshikachalapalli/reliable-checkout-rewards-service#readme",
  "dependencies": {
    "dotenv": "^18.0.8",
    "express": "^5.3.0",
    "pg": "^8.23.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  }
}
